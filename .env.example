# Jenkins Hardening Audit Configuration
# Copy this file to .env and fill in your Jenkins credentials

# Jenkins instance URL (required)
JENKINS_URL=https://jenkins.example.com

# API user (required)
JENKINS_USER=audit-bot

# API token (preferred over password, required)
# Generate via Jenkins UI: User → Configure → API Token → Generate
JENKINS_TOKEN=your-api-token-here

# Optional: Set to true to skip TLS certificate verification (not recommended for production)
# INSECURE=false
